# Copy to .env and fill in. Never commit .env.

# Which LLM backend the brain talks to.
#   gemma_vllm -> self-hosted Gemma 4 on AWS GPU (vLLM OpenAI-compatible server)
#   ollama     -> local/remote Ollama running gemma
#   mock       -> deterministic responses, no GPU needed (for local dev + CI)
FRIDAY_LLM_PROVIDER=mock

# Agent step engine: legacy (mock/ollama/vllm) | maf (Microsoft Agent Framework)
# See docs/MAF_SETUP.md
FRIDAY_AGENT_ENGINE=maf
FRIDAY_MAF_BACKEND=ollama
FRIDAY_MAF_MODEL=gemma3:12b
FRIDAY_OLLAMA_MODEL=gemma3:12b
# Azure (keep for cloud proof — switch FRIDAY_MAF_BACKEND=azure when testing cloud)
FRIDAY_MAF_AZURE_ENDPOINT=
FRIDAY_MAF_AZURE_API_KEY=
FRIDAY_MAF_API_VERSION=2024-08-01-preview

# Gemma 4 via vLLM (OpenAI-compatible). On AWS this is the private IP of the GPU box.
FRIDAY_GEMMA_BASE_URL=http://127.0.0.1:8000/v1
FRIDAY_GEMMA_MODEL=google/gemma-4-12b-it
FRIDAY_GEMMA_API_KEY=friday-local-key

# Ollama (alternative)
FRIDAY_OLLAMA_BASE_URL=http://127.0.0.1:11434
FRIDAY_OLLAMA_MODEL=gemma4:e4b

# Auth token the Android app must send (Authorization: Bearer <token>)
FRIDAY_API_TOKEN=change-me-to-a-long-random-string

# Persona
FRIDAY_PERSONA=lorena

# Safety: require human approval before these actions execute on the real account
FRIDAY_APPROVAL_ACTIONS=post,comment,dm,follow,unfollow

# TTS — OmniVoice on the GPU box (see infra/omnivoice/)
#   mock       -> silent WAV stub (local dev + CI)
#   omnivoice  -> high-quality Friday assistant voice
FRIDAY_TTS_PROVIDER=mock
FRIDAY_VOICE_ENABLED=false
FRIDAY_OMNIVOICE_URL=http://127.0.0.1:8001
FRIDAY_OMNIVOICE_INSTRUCT=female, low pitch, calm, warm, american accent

# Cloud gallery — where raw clips/photos live before posting
#   local -> brain/data/gallery/manifest.json (dev)
#   s3    -> manifest JSON on S3 + media under gallery/raw/
FRIDAY_GALLERY_BACKEND=local
FRIDAY_GALLERY_S3_BUCKET=
FRIDAY_GALLERY_S3_MANIFEST_KEY=gallery/manifest.json
FRIDAY_GALLERY_S3_REGION=us-east-1

# Vision — multimodal model SEES gallery images before curating
FRIDAY_VISION_ENABLED=true
FRIDAY_VISION_MODEL=google/gemma-3-12b-it
FRIDAY_VISION_BASE_URL=
FRIDAY_VISION_MAX_SIDE_PX=768

# Inbox — selective DM/comment replies (default: 2 replies per user per day)
FRIDAY_INBOX_MAX_REPLIES_PER_USER_PER_DAY=2
FRIDAY_INBOX_COMMENT_MAX_PER_USER_PER_DAY=2
FRIDAY_INBOX_MAX_REPLIES_GLOBAL_PER_DAY=40
FRIDAY_INBOX_MIN_HOURS_BETWEEN_SAME_USER=4
FRIDAY_INBOX_SKIP_LOW_EFFORT=true
FRIDAY_INBOX_LOW_EFFORT_REPLY_PROBABILITY=0.35
FRIDAY_INBOX_REPLY_PACE_PROBABILITY=0.65

# Sampling
FRIDAY_TEMPERATURE=0.7
FRIDAY_MAX_TOKENS=512

# LLM resilience (retries on timeout / 5xx)
FRIDAY_LLM_TIMEOUT=120
FRIDAY_LLM_MAX_RETRIES=2
FRIDAY_LLM_RETRY_BACKOFF_S=0.5

# Session run traces — per-step observability (default: brain/data/runs/)
FRIDAY_RUNS_DATA_PATH=

# RAG — gallery curation + caption style retrieval (local SQLite index)
FRIDAY_RAG_ENABLED=true
FRIDAY_RAG_GALLERY_TOP_K=20
FRIDAY_RAG_CAPTION_TOP_K=5
FRIDAY_RAG_INDEX_PATH=
FRIDAY_RAG_HYBRID_ENABLED=true
FRIDAY_RAG_HYBRID_ALPHA=0.6
# mock (CI/local) | ollama | gemma_vllm | openai | azure
FRIDAY_EMBEDDING_PROVIDER=mock
FRIDAY_EMBEDDING_MODEL=nomic-embed-text
FRIDAY_EMBEDDING_BASE_URL=
FRIDAY_EMBEDDING_API_KEY=
FRIDAY_EMBEDDING_DIMENSIONS=384
# --- Production on AWS GPU (Ollama sidecar or host) ---
# FRIDAY_EMBEDDING_PROVIDER=ollama
# FRIDAY_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# FRIDAY_EMBEDDING_MODEL=nomic-embed-text
# --- Azure OpenAI embeddings (managed cloud) ---
# FRIDAY_EMBEDDING_PROVIDER=azure
FRIDAY_EMBEDDING_AZURE_ENDPOINT=
FRIDAY_EMBEDDING_AZURE_API_KEY=
FRIDAY_EMBEDDING_AZURE_DEPLOYMENT=text-embedding-3-small
FRIDAY_EMBEDDING_AZURE_API_VERSION=2024-10-21
